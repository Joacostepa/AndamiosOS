# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Anthropic (Claude AI - usado para cotizaciones y computos)
ANTHROPIC_API_KEY=sk-ant-...

# AFIP (facturacion electronica argentina)
AFIP_CERT_B64=certificado-base64
AFIP_KEY_B64=clave-privada-base64
AFIP_CUIT=20123456789

# Google Maps (geocodificacion y mapas)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...

# Odoo (fuente de verdad comercial: clientes, CRM, cotizaciones, facturacion, flota)
# Usar un usuario de integracion dedicado, NO la cuenta admin.
# La API key se genera en Odoo: avatar > Mi perfil > Seguridad de la cuenta > Nueva clave API
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=tuempresa
ODOO_USERNAME=integracion@tuempresa.com
ODOO_API_KEY=tu-api-key-de-odoo
# Opcional: uid del usuario de integracion (Settings > Usuarios > el id de la URL).
# Odoo Online limita fuerte los logins y en serverless cada instancia fria se loguea de
# nuevo; con esta variable seteada la app nunca toca ese endpoint.
ODOO_UID=2
# Secret para endpoints de sync server-to-server (/api/odoo/sync). Generar con: openssl rand -hex 32
ODOO_SYNC_SECRET=genera-un-secret-aleatorio
# Secret del cron diario de informes de obra (/api/informes-obra/generar). Vercel Cron lo
# manda como `Authorization: Bearer $CRON_SECRET`. Sin esta variable el endpoint rechaza
# todo con 401: falla cerrado a proposito. Generar con: openssl rand -hex 32
CRON_SECRET=genera-un-secret-aleatorio
# Connection string directa a Postgres (Settings > Database > Connection string > Session pooler) para migraciones/DDL
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Slack — espejo de las notificaciones en los canales del equipo.
# Un Incoming Webhook esta atado a UN canal: por eso hay una URL por canal y no una sola.
# Se generan en https://api.slack.com/apps > (tu app) > Incoming Webhooks > Add New Webhook
# to Workspace, eligiendo el canal en el desplegable. Son secretas: quien tenga la URL
# puede escribir en el canal.
# SIN ESTAS VARIABLES LA APP FUNCIONA IGUAL y no manda nada a Slack: los avisos siguen
# llegando a la campanita. No hace falta configurarlas en local.
# Canal #syh-documentacion-de-obra
SLACK_WEBHOOK_SYH=https://hooks.slack.com/services/T000/B000/xxxx
# Canal #logistica-operativa
SLACK_WEBHOOK_LOGISTICA=https://hooks.slack.com/services/T000/B000/yyyy
# Dominio publico de la app, para que los avisos de Slack lleven un link clickeable. En
# Vercel se puede omitir: cae solo en VERCEL_PROJECT_PRODUCTION_URL. Sin ninguno de los
# dos el mensaje sale igual, pero sin link.
NEXT_PUBLIC_APP_URL=https://tuapp.vercel.app
